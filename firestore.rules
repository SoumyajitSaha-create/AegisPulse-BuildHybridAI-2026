rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: IncidentLog
    function isValidIncident(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.category in ['TRIAGE', 'SCENE_SCAN', 'RESPONDER_BRIEF'] &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.promptSummary is string &&
             data.promptSummary.size() >= 1 &&
             data.promptSummary.size() <= 1200 &&
             data.urgencyLevel in ['CRITICAL', 'HIGH', 'MODERATE', 'INFO'] &&
             data.guidanceSummary is string &&
             data.guidanceSummary.size() >= 1 &&
             data.guidanceSummary.size() <= 6000 &&
             data.checklistSteps is list &&
             data.checklistSteps.size() <= 25 &&
             (data.checklistSteps.size() == 0 || data.checklistSteps[0] is string) &&
             (!('doNotDoNotes' in data) || data.doNotDoNotes == null || (data.doNotDoNotes is string && data.doNotDoNotes.size() <= 1500)) &&
             data.inferenceSource in ['ON_DEVICE', 'IN_CLOUD', 'HYBRID'] &&
             data.latencyMs is int &&
             data.latencyMs >= 0 &&
             data.latencyMs <= 300000 &&
             (!('platform' in data) || data.platform in ['ANDROID', 'WEB']) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Validation Blueprint: TelemetryEntry
    function isValidTelemetry(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.taskType is string &&
             data.taskType.size() >= 1 &&
             data.taskType.size() <= 80 &&
             data.requestedMode in ['PREFER_ON_DEVICE', 'ONLY_ON_DEVICE', 'PREFER_IN_CLOUD', 'ONLY_IN_CLOUD'] &&
             data.actualSource in ['ON_DEVICE', 'IN_CLOUD'] &&
             data.latencyMs is int &&
             data.latencyMs >= 0 &&
             data.latencyMs <= 300000 &&
             data.promptChars is int &&
             data.promptChars >= 0 &&
             data.promptChars <= 50000 &&
             data.routingReason is string &&
             data.routingReason.size() >= 1 &&
             data.routingReason.size() <= 300 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // User-scoped Incident Logs Subcollection
    match /users/{userId}/incidents/{incidentId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(incidentId);

      allow create: if isOwner(userId) &&
                       isValidId(incidentId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'category',
                         'title',
                         'promptSummary',
                         'urgencyLevel',
                         'guidanceSummary',
                         'checklistSteps',
                         'inferenceSource',
                         'latencyMs',
                         'platform',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'category',
                         'title',
                         'promptSummary',
                         'urgencyLevel',
                         'guidanceSummary',
                         'checklistSteps',
                         'doNotDoNotes',
                         'inferenceSource',
                         'latencyMs',
                         'platform',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidIncident(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(incidentId) &&
                       isValidIncident(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().category == existing().category &&
                       incoming().createdAt == existing().createdAt &&
                       (!('platform' in existing()) || incoming().platform == existing().platform) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'urgencyLevel',
                         'guidanceSummary',
                         'checklistSteps',
                         'doNotDoNotes',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(incidentId);
    }

    // User-scoped Hybrid AI Routing Telemetry Subcollection (Immutable log entries)
    match /users/{userId}/telemetry/{logId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(logId);

      allow create: if isOwner(userId) &&
                       isValidId(logId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'taskType',
                         'requestedMode',
                         'actualSource',
                         'latencyMs',
                         'promptChars',
                         'routingReason',
                         'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'taskType',
                         'requestedMode',
                         'actualSource',
                         'latencyMs',
                         'promptChars',
                         'routingReason',
                         'createdAt'
                       ]) &&
                       isValidTelemetry(incoming());

      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(logId);
    }
  }
}
